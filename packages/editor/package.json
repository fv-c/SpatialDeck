{
  "name": "@spatialdeck/editor",
  "version": "0.6.0",
  "description": "React editor of SpatialDeck Studio: command store with undo/redo, IndexedDB recovery, archive I/O and the Studio component.",
  "license": "GPL-3.0-or-later",
  "author": "Francesco Vitucci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fv-c/SpatialDeck.git",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/fv-c/SpatialDeck/tree/main/packages/editor#readme",
  "bugs": {
    "url": "https://github.com/fv-c/SpatialDeck/issues"
  },
  "keywords": [
    "spatialdeck",
    "presentation",
    "editor",
    "react",
    "studio"
  ],
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/browser.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/editor.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/package-license.mjs"
  },
  "dependencies": {
    "@spatialdeck/core": "workspace:*",
    "@spatialdeck/player": "workspace:*",
    "@spatialdeck/plugins": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
