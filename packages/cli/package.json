{
  "name": "@spatialdeck/cli",
  "version": "0.6.0",
  "description": "SpatialDeck command line: validate projects, build static bundles and export standalone HTML, PDF and WebM from an explicit itinerary.",
  "license": "GPL-3.0-or-later",
  "author": "Francesco Vitucci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fv-c/SpatialDeck.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/fv-c/SpatialDeck/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/fv-c/SpatialDeck/issues"
  },
  "keywords": [
    "spatialdeck",
    "presentation",
    "cli",
    "export",
    "pdf",
    "webm"
  ],
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "spatialdeck": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build -c vite.runtime.config.ts",
    "prepack": "node ../../scripts/package-license.mjs"
  },
  "dependencies": {
    "@spatialdeck/core": "workspace:*",
    "@spatialdeck/player": "workspace:*",
    "@spatialdeck/plugins": "workspace:*",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.64.1"
  }
}
