{
  "name": "@spatialdeck/core",
  "version": "0.6.0",
  "description": "Pure TypeScript domain of SpatialDeck: document schema 1.0.0–1.3.0, validation, migration, camera math, navigation, sampling and export itineraries. No DOM.",
  "license": "GPL-3.0-or-later",
  "author": "Francesco Vitucci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fv-c/SpatialDeck.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/fv-c/SpatialDeck/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/fv-c/SpatialDeck/issues"
  },
  "keywords": [
    "spatialdeck",
    "presentation",
    "spatial",
    "schema",
    "non-linear",
    "camera"
  ],
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/project-1.3.0.schema.json",
    "./schema/1.0.0": "./schema/project-1.0.0.schema.json",
    "./schema/1.1.0": "./schema/project-1.1.0.schema.json",
    "./schema/1.2.0": "./schema/project-1.2.0.schema.json",
    "./schema/1.3.0": "./schema/project-1.3.0.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/package-license.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "gl-matrix": "^3.4.4"
  }
}
