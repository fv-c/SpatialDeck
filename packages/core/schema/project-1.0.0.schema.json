{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spatialdeck:project:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "metadata",
    "settings",
    "requiredCapabilities",
    "scenes",
    "assets",
    "paths",
    "defaultPathId",
    "extensions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language"],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "author": {
          "type": "string",
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "maxLength": 20000
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewport", "presentation"],
      "properties": {
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "perspective"],
          "properties": {
            "width": {
              "$ref": "#/$defs/size"
            },
            "height": {
              "$ref": "#/$defs/size"
            },
            "perspective": {
              "type": "number",
              "minimum": 1,
              "maximum": 100000
            }
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fit", "motion", "defaultTransition"],
          "properties": {
            "fit": {
              "const": "contain"
            },
            "motion": {
              "enum": ["system", "reduced"]
            },
            "defaultTransition": {
              "$ref": "#/$defs/transition"
            }
          }
        }
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "const": "linear"
      }
    },
    "scenes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "paths": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "defaultPathId": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,96}$"
    },
    "coord": {
      "type": "number",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "size": {
      "type": "number",
      "minimum": 1,
      "maximum": 100000
    },
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/coord"
        },
        {
          "$ref": "#/$defs/coord"
        },
        {
          "$ref": "#/$defs/coord"
        }
      ],
      "items": false,
      "minItems": 3
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMs", "easing"],
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "easing": {
          "enum": ["linear", "ease-in-out"]
        }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9.-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "data"],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "data": {}
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "data"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "text"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 100000
            }
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "position",
        "rotation",
        "scale",
        "size",
        "visible",
        "blocks",
        "notes",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/vec3"
        },
        "scale": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 10000
        },
        "size": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/size"
            },
            {
              "$ref": "#/$defs/size"
            }
          ],
          "items": false,
          "minItems": 2
        },
        "visible": {
          "type": "boolean"
        },
        "blocks": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 100000
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "mime", "byteLength"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "mime": {
          "type": "string",
          "maxLength": 128
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 52428800
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sceneId", "holdMs"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "holdMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "label", "transition"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "maxLength": 500
        },
        "transition": {
          "$ref": "#/$defs/transition"
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "startNodeId", "nodes", "edges"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "maxLength": 500
        },
        "startNodeId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "nodes": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    }
  }
}
