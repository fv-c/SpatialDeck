{
  "name": "@spatialdeck/plugins",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk.js"
    },
    "./rich": {
      "types": "./dist/rich.d.ts",
      "import": "./dist/rich.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    },
    "./sample": {
      "types": "./dist/sample.d.ts",
      "import": "./dist/sample.js"
    },
    "./builtins": {
      "types": "./dist/builtins.d.ts",
      "import": "./dist/builtins.js"
    },
    "./style.css": "./dist/plugins.css",
    "./archive": {
      "types": "./dist/archive.d.ts",
      "import": "./dist/archive.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@spatialdeck/core": "workspace:*",
    "@spatialdeck/player": "workspace:*",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "katex": "0.19.0",
    "fflate": "0.8.3"
  }
}
