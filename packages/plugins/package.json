{
  "name": "@spatialdeck/plugins",
  "version": "0.6.0",
  "description": "Optional SpatialDeck renderers (Markdown, HTML, SVG, LaTeX, media, links, embeds), the plugin SDK and the .spatialdeck archive format.",
  "license": "GPL-3.0-or-later",
  "author": "Francesco Vitucci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fv-c/SpatialDeck.git",
    "directory": "packages/plugins"
  },
  "homepage": "https://github.com/fv-c/SpatialDeck/tree/main/packages/plugins#readme",
  "bugs": {
    "url": "https://github.com/fv-c/SpatialDeck/issues"
  },
  "keywords": [
    "spatialdeck",
    "presentation",
    "plugins",
    "katex",
    "markdown",
    "sanitizer"
  ],
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk.js"
    },
    "./rich": {
      "types": "./dist/rich.d.ts",
      "import": "./dist/rich.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    },
    "./sample": {
      "types": "./dist/sample.d.ts",
      "import": "./dist/sample.js"
    },
    "./builtins": {
      "types": "./dist/builtins.d.ts",
      "import": "./dist/builtins.js"
    },
    "./style.css": "./dist/plugins.css",
    "./archive": {
      "types": "./dist/archive.d.ts",
      "import": "./dist/archive.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/katex-fonts.mjs && tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/package-license.mjs"
  },
  "dependencies": {
    "@spatialdeck/core": "workspace:*",
    "@spatialdeck/player": "workspace:*",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "katex": "^0.19.0",
    "marked": "^18.1.1"
  }
}
