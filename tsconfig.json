{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@spatialdeck/core": ["./packages/core/src/index.ts"],
      "@spatialdeck/player/presenter": ["./packages/player/src/presenter.ts"],
      "@spatialdeck/player": ["./packages/player/src/index.ts"],
      "@spatialdeck/editor": ["./packages/editor/src/index.ts"],
      "@spatialdeck/plugins": ["./packages/plugins/src/sdk/index.ts"],
      "@spatialdeck/plugins/*": ["./packages/plugins/src/*"]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "tests/**/*.ts",
    "tools/**/*.ts",
    "scripts/**/*.test.ts",
    "*.ts",
    "packages/**/*.tsx",
    "apps/**/*.tsx"
  ]
}
