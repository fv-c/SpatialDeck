{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@spatialdeck/core": ["./packages/core/src/index.ts"],
      "@spatialdeck/player": ["./packages/player/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "tests/**/*.ts",
    "tools/**/*.ts",
    "scripts/**/*.test.ts",
    "*.ts"
  ]
}
