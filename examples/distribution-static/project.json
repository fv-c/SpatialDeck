  ],
  "assets": [
    {
      "id": "orbit",
      "path": "assets/orbit.svg",
      "mime": "image/svg+xml",
      "byteLength": 615,
      "sha256": "55d01a21425696eb9333b33d83f20424f60616f251a18b4f6f8e20c1e5e87c1f"
    }
  ],
  "paths": [
    {
      "id": "main",
      "name": "Main",
      "startNodeId": "n1",
      "loopPolicy": {
        "maxVisitsPerNode": 2
      },
      "nodes": [
        {
          "id": "n1",
          "sceneId": "cover",
          "holdMs": 1000
        },
        {
          "id": "n2",
          "sceneId": "context",
          "holdMs": 1000
        },
        {
          "id": "n3",
          "sceneId": "detail",
          "holdMs": 1000
        }
      ],
      "edges": [
        {
          "id": "e1",
          "from": "n1",
          "to": "n2",
          "label": "Context",
          "transition": {
            "durationMs": 800,
            "easing": "ease-in-out"
          },
          "condition": {
            "kind": "visit-limit",
            "maxVisits": 2
          }
        },
        {
          "id": "e2",
          "from": "n2",
          "to": "n3",
          "label": "Detail",
          "transition": {
            "durationMs": 1000,
            "easing": "linear"
          },
          "cameraTrackId": "swing",
          "condition": {
            "kind": "visit-limit",
            "maxVisits": 2
          }
        },
        {
          "id": "e3",
          "from": "n3",
          "to": "n1",
          "label": "Again",
          "transition": {
            "durationMs": 600,
            "easing": "ease-in-out"
          },
          "condition": {
            "kind": "manual"
          }
        }
      ]
    }
  ],
  "defaultPathId": "main",
  "cameraTracks": [
    {
      "id": "swing",
      "interpolation": "cubic",
      "easing": "ease-in-out",
      "keyframes": [
        {
          "at": 0,
          "pose": {
            "position": [1700, 200, -300],
            "rotation": [0, 25, 0],
            "zoom": 1
          }
        },
        {
          "at": 0.5,
          "pose": {
            "position": [1000, 700, 0],
            "rotation": [0, 5, 0],
            "zoom": 0.6
          }
        },
        {
          "at": 1,
          "pose": {
            "position": [310, 880, 80],
            "rotation": [8, -12, 5],
            "zoom": 1.1
          }
        }
      ]
    }
  ],
