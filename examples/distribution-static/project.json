{
  "schemaVersion": "1.3.0",
  "id": "distribution-static",
  "metadata": {
    "title": "Distribution fixture",
    "language": "en",
    "author": "SpatialDeck example",
    "description": "0.6 fixture: canvas scene, theme font, formula, local image, camera track, explicit loop and private notes, exported to HTML, PDF and WebM."
  },
  "settings": {
    "viewport": {
      "width": 1280,
      "height": 720,
      "perspective": 1000
    },
    "presentation": {
      "fit": "contain",
      "motion": "system",
      "defaultTransition": {
        "durationMs": 600,
        "easing": "ease-in-out"
      }
    }
  },
  "requiredCapabilities": ["linear", "structure", "blocks", "layout"],
  "theme": {
    "palette": [
      {
        "id": "ink",
        "value": "#102a43"
      },
      {
        "id": "paper",
        "value": "#fffdf7"
      },
      {
        "id": "teal",
        "value": "#0f766e"
      },
      {
        "id": "violet",
        "value": "#6d28d9"
      },
      {
        "id": "dusk",
        "value": "#243b53"
      }
    ],
    "colors": {
      "text": "ink",
      "background": "paper",
      "accent": "teal",
      "backdrop": "dusk"
    },
    "fonts": {
      "body": "atkinson-hyperlegible",
      "heading": "atkinson-hyperlegible"
